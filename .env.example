# Operating Mode: DEMO or PRODUCTION
APP_MODE=DEMO

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=super-secret-jwt-token-key-change-in-production-32bytes!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (SQL Server / SQLite fallback for DEMO)
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=HotelRevenueDB
DB_USER=sa
DB_PASSWORD=YourPassword123!
# SQLite fallback connection string for DEMO mode if SQL Server is not running
DATABASE_URL=sqlite:///./hotel_revenue_demo.db

# Redis Caching (Optional for DEMO mode)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Provider Credentials (Required for PRODUCTION mode, mocked in DEMO mode)
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Vector Database (ChromaDB)
CHROMA_DB_DIR=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# System Guardrail Defaults
MAX_DAILY_PRICE_CHANGE_PCT=0.20
MAX_WEEKLY_PRICE_CHANGE_PCT=0.35
APPROVAL_THRESHOLD_PCT=0.10
DEFAULT_MIN_RATE_FLOOR=1000.0
DEFAULT_MAX_RATE_CEILING=50000.0
